<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  hive-site.xml cho Hive Metastore 3.1.3 (container) - slice 1.

  Loi co dinh: entrypoint.sh cua anh apache/hive:3.1.3 thay HADOOP_CONF_DIR =
  HIVE_CONF_DIR khi dat HIVE_CUSTOM_CONF_DIR, nen thu muc nay phai co du
  core-site.xml + hdfs-site.xml + hive-site.xml.

  Vi sao dung Hive 3.1.3 chu khong phai 4.x: Spark 4.0.1 goi Thrift
  `get_table(dbName, tblName)`. Method nay con trong IDL 4.0.0 nhung bi xoat tu
  4.1.0 (da do truc tiep tren jar cua standalone-metastore-4.2.1 -> Spark bao
  "Invalid method name: 'get_table'"). 3.1.3 van giu API cho khach 2.3.9.
-->
<configuration>
  <!-- Derby phải nằm trên volume ./data/metastore; nếu dùng đường dẫn tương đối
       thì nó tạo /opt/hive/metastore_db trong layer của container và bị mất khi
       recreate. Đường dẫn tuyệt đối + thư mục chưa tồn tại => initSchema tự tạo. -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:;databaseName=/opt/hive/data/metastore_db;create=true</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.apache.derby.jdbc.EmbeddedDriver</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionUserName</name>
    <value>APP</value>
  </property>
  <property>
    <name>javax.jdo.option.ConnectionPassword</name>
    <value>APP</value>
  </property>

  <!-- Location cua database/bang ma HMS tra ve cho client. PHAI co scheme hdfs://
       va dung IP do duoc tu ben ngoai mang Docker, vi Spark chay tren Windows la
       ben ngoai; ten "namenode" chi be trong compose network moi resolve duoc.
       IP o day PHAI trung voi IP Wi-Fi hien tai cua may (2026-11-05: 192.168.100.17;
       con so 192.168.100.19 trong lich su do dac ben hdfs-site.xml KHONG dung nua).
       HMS luu location vung ve trong DB Derby, nen sau khi doi IP phai chay
       .\tools\Set-Host.ps1 -RebuildCatalog de tao lai database bang IP moi. -->
  <property>
    <name>metastore.warehouse.dir</name>
    <value>hdfs://192.168.100.17:8020/opt/hive/data/warehouse</value>
  </property>

  <!-- Spark 4.0.1 mang ve Hive client 2.3.9; server 3.1.3 mac dinh bat
       hive.metastore.schema.verification=true va che "Metastore version mismatch".
       Tat kiem hoa don version: schema van du, chi bo buoc doi chieu chuoi. -->
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.metastore.schema.verification.record.version</name>
    <value>false</value>
  </property>
  <property>
    <name>datanucleus.schema.autoCreateAll</name>
    <value>false</value>
  </property>

  <!-- HMS tu quy quyen tren duong dan HDFS; tat do de tai khoan Derby/HDFS root
       khong bi chan permission khi tao database. -->
  <property>
    <name>hive.metastore.execute.setugi</name>
    <value>false</value>
  </property>
</configuration>
